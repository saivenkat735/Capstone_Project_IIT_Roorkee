# ===========================================================
# BudgetWise AI Service - Environment Configuration
# Copy this file to `.env` and adjust as needed.
# ===========================================================

# --- App ---
APP_PORT=8000
# JSON array of allowed CORS origins (React dev server + Spring Gateway)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- JWT (MUST match Spring Boot Secure service secret) ---
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437
JWT_ALGORITHM=HS256

# --- LLM Provider ---
# Options: "ollama" (default, free, local) | "openai"
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# --- Embedding Provider ---
# Options: "sentence-transformers" (default, free, local) | "openai"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Store (ChromaDB persistent client) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=budgetwise_kb

# --- Relational Storage (SQLite replaces Supabase) ---
SQLITE_URL=sqlite+aiosqlite:///./data/budgetwise_ai.db

# --- Existing Spring Boot microservices (for Dynamic RAG tool calls) ---
BACKEND_SECURE_URL=http://localhost:9099
BACKEND_ACCOUNTS_URL=http://localhost:2001
BACKEND_TRANSACTIONS_URL=http://localhost:2002
BACKEND_BILLS_URL=http://localhost:9007
BACKEND_CATEGORY_URL=http://localhost:2004

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RESULTS=4
